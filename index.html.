Preparar plataforma DIGITAL SOUND MOZ
<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="DIGITAL SOUND MOZ - Descubra, conheça e valorize os talentos musicais de Moçambique.">
<title>DIGITAL SOUND MOZ | Música sem fronteiras</title>
<style>
:root{
--bg:#0c100f;
--panel:#151d19;
--green:#16c995;
--gold:#d9b66b;
--white:#f5f7f5;
--muted:#a5b1aa;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--white);font-family:Arial,sans-serif}
header{padding:20px 7%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #26342c;flex-wrap:wrap;gap:15px}
.logo{font-size:21px;font-weight:900;color:var(--green)}
.logo span{color:var(--gold)}
nav{display:flex;gap:20px;flex-wrap:wrap}
nav a{color:white;text-decoration:none;font-size:14px}
nav a:hover{color:var(--green)}
.hero{padding:85px 8%;background:radial-gradient(ellipse at 85% 30%,#174b37 0%,#14231c 35%,#0c100f 75%);min-height:380px}
.hero small{color:var(--gold);letter-spacing:3px}
.hero h1{font-size:clamp(35px,6vw,65px);max-width:750px;margin:20px 0}
.hero h1 span{color:var(--green)}
.hero p{color:var(--muted);max-width:550px;line-height:1.8}
.btn{display:inline-block;padding:14px 23px;background:var(--green);color:#07140e;text-decoration:none;border-radius:5px;font-weight:bold;margin:12px 8px 0 0}
.btn.secondary{background:transparent;border:1px solid var(--gold);color:var(--gold)}
section{padding:55px 7%}
.heading{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap}
.heading h2{font-size:26px}
.heading h2 span{color:var(--green)}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:18px}
.card{background:var(--panel);border:1px solid #26342c;border-radius:10px;overflow:hidden}
.art{height:155px;display:grid;place-items:center;font-size:48px;background:linear-gradient(140deg,#164d38,#263b32,#4c3923)}
.card-content{padding:17px}
.card h3{margin:0 0 8px}
.card p{color:var(--muted);font-size:13px}
.tag{font-size:11px;color:var(--gold);letter-spacing:1px}
.about{background:#121b16}
.about p{color:var(--muted);line-height:1.9;max-width:750px}
.register{background:linear-gradient(120deg,#143c2c,#17241d);text-align:center;border-radius:12px;padding:40px 20px}
footer{background:#080c0a;padding:35px 7%;border-top:1px solid #26342c}
footer p{color:var(--muted);font-size:13px;line-height:1.8}
input,textarea{width:100%;padding:13px;margin:8px 0;background:#101713;border:1px solid #405047;border-radius:5px;color:white}
form{max-width:500px;margin:25px auto;text-align:left}
button{padding:13px 20px;background:var(--green);border:0;border-radius:5px;font-weight:bold;cursor:pointer}
.notice{font-size:12px;color:var(--gold)}
@media(max-width:600px){
header{padding:18px 5%}
nav{gap:13px}
.hero{padding:60px 6%}
section{padding:40px 6%}
}
</style>
</head>
<body>

<header>
<div class="logo">DIGITAL SOUND <span>MOZ.</span></div>
<nav>
<a href="#inicio">Início</a>
<a href="#musicas">Músicas</a>
